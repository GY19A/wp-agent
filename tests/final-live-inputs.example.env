# WP Agent final live acceptance inputs.
#
# This file is an example only. Keep real tokens out of the repository and pass
# secrets through the shell, the WordPress Settings screen, or a local ignored
# environment file.

# Scope can be all, github, soak, or a comma-separated combination.
WP_AGENT_FINAL_PREFLIGHT_SCOPE=all
WP_AGENT_FINAL_PREFLIGHT_STRICT=1

# Official GitHub Skills Store live gate.
# Replace owner/repo and skills/example with the user-approved official Skill
# Store coordinates before running live GitHub acceptance.
WP_AGENT_LIVE_GITHUB_SKILLS=1
WP_AGENT_LIVE_GITHUB_REPOSITORY=owner/repo
WP_AGENT_LIVE_GITHUB_SKILL_PATH=skills/example
WP_AGENT_LIVE_GITHUB_REF=main
WP_AGENT_LIVE_GITHUB_REVIEW_POLICY=quarantine
# WP_AGENT_LIVE_GITHUB_TOKEN is intentionally omitted here. Set it outside this
# file only when a private repository or higher GitHub API limit is required.

# Multi-hour editorial daemon soak gate.
WP_AGENT_LIVE_EDITORIAL_DAEMON=1
WP_AGENT_LIVE_EDITORIAL_DAEMON_APPROVED=1
# Keep this placeholder until the exact soak window, API budget, source URL, and
# artifact policy have been reviewed. Final preflight requires the exact phrase
# approve-multi-hour-soak.
WP_AGENT_LIVE_EDITORIAL_DAEMON_APPROVAL_PHRASE=replace-after-review
WP_AGENT_LIVE_EDITORIAL_DAEMON_COST_BUDGET_USD=5
WP_AGENT_LIVE_EDITORIAL_DAEMON_ARTIFACT_POLICY=drafts_journal_usage
WP_AGENT_LIVE_EDITORIAL_DAEMON_RUNS=12
WP_AGENT_LIVE_EDITORIAL_DAEMON_TIMEOUT=14400
WP_AGENT_LIVE_EDITORIAL_DAEMON_SOAK_SECONDS=14400
WP_AGENT_LIVE_EDITORIAL_DAEMON_SAMPLE_INTERVAL=60
WP_AGENT_LIVE_EDITORIAL_DAEMON_MAX_USAGE_ROWS=96
WP_AGENT_LIVE_EDITORIAL_DAEMON_SOURCE_URL=https://wordpress.org/news/
# Optional memory delta guard, in bytes. Enable only when an approved threshold
# is defined for the soak run.
# WP_AGENT_LIVE_EDITORIAL_DAEMON_MEMORY_DELTA_MAX=134217728

# Official acceptance database gate.
WP_AGENT_OFFICIAL_DB_DIR=/path/to/wp-agent/database/official-mysql
# Set this only for an explicitly approved throwaway database run.
# WP_AGENT_FINAL_PREFLIGHT_ALLOW_NONDEFAULT_DB_DIR=1
